# Maximal Random Slopes Model ----
# set contrasts for factors to polynomials
options(contrasts = c("contr.poly", "contr.poly"))
mod01<-lmer(speed~
# Fixed-effects
1+time.c*condition*age_group+
time.c.sq*condition*age_group+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c+time.c.sq|condition:subID),
data=DATA, REML=TRUE)
anova(mod01)
summary(mod01)
# Maximal Random Slopes Model ----
# set contrasts for factors to polynomials
options(contrasts = c("contr.poly", "contr.poly"))
mod01<-lmer(speed~
# Fixed-effects
1+time.c*condition*age_group+
time.c.sq*condition*age_group+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c+time.c.sq|condition:subID),
data=DATA, REML=TRUE)
summary(mod01)
VarCorr(mod01)
# Zero-correlation alternative ----
mod_orth<-lmer(speed~
# Fixed-effects
1+time.c*condition*age_group+
time.c.sq*condition*age_group+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c+time.c.sq||condition:subID),
data=DATA, REML=TRUE)
summary(mod_orth)
anova(mod_orth)
# Zero-correlation alternative ----
mod_1a<-lmer(speed~
# Fixed-effects
1+time.c*condition*age_group+
time.c.sq*condition*age_group+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c |condition:subID),
data=DATA, REML=TRUE)
VarCorr(mod_1a)
# Dropping quadratic slope at condition level ----
mod_1a<-lmer(speed~
# Fixed-effects
1+time.c*condition*age_group+
time.c.sq*condition*age_group+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c |condition:subID),
data=DATA, REML=TRUE)
VarCorr(mod_1a)
# Dropping all slopes at condition level ----
mod_1b<-lmer(speed~
# Fixed-effects
1+time.c*condition*age_group+
time.c.sq*condition*age_group+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c |condition:subID),
data=DATA, REML=TRUE)
VarCorr(mod_1b)
# Dropping all slopes at condition level ----
mod_1b<-lmer(speed~
# Fixed-effects
1+time.c*condition*age_group+
time.c.sq*condition*age_group+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1|condition:subID),
data=DATA, REML=TRUE)
VarCorr(mod_1b)
# comparison across models
anova(mod1, mod1a, mod_1b)
# comparison across models
anova(mod01, mod_1a, mod_1b)
# comparison across models
AIC(mod01, mod_1a, mod_1b)
BIC(mod01, mod_1a, mod_1b)
# comparison across models
AIC(mod01, mod_1a, mod_1b)
BIC(mod01, mod_1a, mod_1b)
anova(mod_1b)
# comparison across models
anova(mod01, mod_1a, mod_1b)
# summary ANOVA table using Type III sums of squares
anova(mod_1b)
# summary table; requires library("lmerTest") to estimage df and calculate p-values
summary(mod_1b)
#  ANOVA table using Type III sums of squares; requires library("lmerTest")
anova(mod_1b)
