library(tidyverse); library(RCurl); library(ez); library(lme4); library(lmerTest)
DATA <- read.csv("https://raw.githubusercontent.com/keithlohse/mixed_effects_models/master/data_AGING_example.csv")
# NOTE (2024 revision): previously read from "data_example.csv", which no longer exists
# in the repository (404). "data_AGING_example.csv" has the same columns and works
# with all of the code below.
DATA$time.sq <- DATA$time^2
DATA$time.c <- DATA$time-mean(DATA$time, na.rm=TRUE)
DATA$time.c.sq <- DATA$time.c^2
DATA$old.c<-ifelse(DATA$age_group=="YA", 0.5, -0.5)
# NOTE (2024 revision): the original line here was
#   DATA$old.c<-(as.numeric(DATA$age_group)-1.5)*(-1)
# This silently returns old.c = NA for every row under R >= 4.0, because read.csv() no
# longer defaults to stringsAsFactors=TRUE (that default changed in R 4.0.0, 2020), so
# age_group is read in as character rather than factor, and as.numeric() on a character
# vector like "OA"/"YA" returns NA (with a "NAs introduced by coercion" warning) rather
# than the intended 1/2 factor codes. The explicit ifelse() above is also more
# transparent pedagogically: it doesn't rely on knowing that R would have alphabetized
# "OA" before "YA" to land on the intended (-0.5/+0.5) contrast-style coding.
ggplot(DATA, aes(x = time, y = speed)) +
geom_line(aes(group=subID), col="grey", alpha=0.8)+
geom_point(aes(fill=subID), pch=21, size=2)+
stat_smooth(aes(lty=condition, fill=condition), col="black", method="lm", formula=y~poly(x,3), lwd=2)+
facet_wrap(~condition, ncol=3) +
scale_x_continuous(name = "Trial") +
scale_y_continuous(name = "Speed (m/s)") +
theme_bw()+
theme(axis.text=element_text(size=16, color="black"),
axis.title=element_text(size=16, face="bold"),
plot.title=element_text(size=16, face="bold", hjust=0.5),
strip.text = element_text(size=16, face="bold"),
legend.position = "none")
# Fixed slope random intercepts model ----
mod_max<-lmer(speed~
# Fixed-effects
1+time.c*condition+time.c.sq*condition+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c+time.c.sq|condition:subID),
data=DATA, REML=TRUE,
control=lmerControl(optimizer="Nelder_Mead",
optCtrl=list(maxfun=2e5)))
# Fixed slope random intercepts model ----
mod_max<-lmer(speed~
# Fixed-effects
1+time.c*condition+time.c.sq*condition+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c+time.c.sq|condition:subID),
data=DATA, REML=TRUE)
summary()
# Fixed slope random intercepts model ----
mod_max<-lmer(speed~
# Fixed-effects
1+time.c*condition+time.c.sq*condition+
# Random-effects
(1+time.c+time.c.sq|subID)+
(1+time.c+time.c.sq|condition:subID),
data=DATA, REML=TRUE,
control=lmerControl(optimizer="Nelder_Mead",
optCtrl=list(maxfun=2e5)))
summary(mod_max)
# Fixed slope random intercepts model ----
# set contrasts for factors to polynomials
options(contrasts = c("contr.poly", "contr.poly"))
# Fixed slope random intercepts model ----
# set contrasts for factors to polynomials
options(contrasts = c("contr.poly", "contr.poly"))
mod_max<-lmer(speed~
